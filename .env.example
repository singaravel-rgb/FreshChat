# Environment Variables
# Copy to .env and fill in values

# App
APP_NAME=AI-Customer-Support-Platform
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production
API_V1_PREFIX=/api/v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/support_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=support_platform

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_REFRESH_SECRET_KEY=change-me-jwt-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Configuration
AI_ENABLED=true
AI_KILL_SWITCH=false
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-3.5-sonnet
AI_API_KEY=
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Storage (S3/MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=attachments
S3_USE_SSL=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
